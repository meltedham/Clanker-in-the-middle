# Browser/server
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info
# Required whenever production listens beyond loopback. Use 24+ random
# characters and enter the same token in the browser unlock screen.
APP_AUTH_TOKEN=replace-with-a-long-random-demo-token

# Optional users seeded into the store at boot, for reproducible demo
# accounts. Format: "id:name:token,id:name:token[:role]", role is "member"
# (default) or "admin". Additional users can also be created at runtime via
# POST /api/users; identity/ownership enforcement activates the moment any
# user exists in the store, seeded or not. Leave unset to keep the
# single-user baseline (or the legacy shared APP_AUTH_TOKEN) unchanged.
APP_USERS=

# OpenRouter. OPENROUTER_MODEL is a model slug that supports the OpenAI-
# compatible Responses API, for example openai/gpt-4o-mini.
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=replace-with-your-model-slug
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: a separate model slug for RAG embeddings. Falls back to a local
# embedding model when unset or rate-limited.
OPENROUTER_EMBEDDING_MODEL=

# Runtime paths (Docker defaults are already correct).
APP_DATA_DIR=/app/data
AGENT_WORKSPACE_ROOT=/app/workspaces
SHARED_RESOURCE_ROOT=/app/shared-resources
CODEX_HOME=/app/codex-home
CODEX_BIN=codex

# Codex runs inside the dedicated ECS/container boundary. Requires Landlock
# support on the host kernel for workspace-write to be enforced -- startup
# refuses to run instead of silently falling back to unrestricted access.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152
# Prompts longer than this are rejected before a Run ever starts.
MAX_PROMPT_CHARS=20000
# POST /api/login is throttled per source IP: at most LOGIN_RATE_LIMIT_MAX
# attempts per LOGIN_RATE_LIMIT_WINDOW_MS, to slow down credential stuffing
# against password accounts.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# Runtime provider. The ECS/Compose image uses local-process because Codex is
# installed in the application container. scripts/start-local-poc.sh overrides
# this to container and starts a disposable Docker/Colima/Podman Runtime.
RUNTIME_PROVIDER=local-process
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000
